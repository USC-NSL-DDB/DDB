# Copy this file to artifact.env and set the controller/SSH values before setup.

# Private address assigned to the controller on the Chameleon cluster network.
CONTROLLER_IP=10.0.0.1

# Four worker SSH targets are read from workers.txt by default.
# WORKERS_FILE=/absolute/path/to/workers.txt

# Set only when the controller needs a specific key to reach the workers.
# SSH_IDENTITY_FILE=$HOME/.ssh/chameleon_key
# SSH_CONNECT_TIMEOUT=10

# By default setup stops if firewalld is active. Set this only after opening the
# required k3s traffic on the private cluster network yourself.
# ALLOW_ACTIVE_FIREWALL=1

# Set these only when reusing a nonstandard native-k3s server installation.
# TARGET_NODE=controller-kubernetes-node-name
# KUBECONFIG=/path/to/existing-k3s.yaml
# K3S_SERVICE=existing-k3s.service
# NAMESPACE=default

# The only external source trees used by the recipe.
# DDB_REPO_ROOT=/absolute/path/to/DDB
# DDB_SOURCE_DIR=/absolute/path/to/DDB/ddb
# SOCIALNET_DIR=/absolute/path/to/DDB/fwks/socialnetwork
# DDB_BIN=/absolute/path/to/DDB/ddb/target/release/ddb
# EXPECTED_SOCIALNET_COMMIT=613f316ca060b94545e850324f91eef1ceb7639b

# Build/runtime inputs.
# SOCIALNET_GO_IMAGE=golang:1.21.1
# SOCIALNET_RUNTIME_IMAGE=docker.io/OWNER/IMAGE@sha256:DIGEST
# RESULTS_ROOT=/path/to/sw-socialnet-command-latency/results
# DDB_LOG_DIR=/path/to/runtime/logs
# DDB_BASE_DIR=/path/to/runtime

# Full-run measurement controls.
# COMMAND_WARMUP_PASSES=1
# COMMAND_REPETITIONS=30
# COMMAND_THREAD_LIMIT=0
