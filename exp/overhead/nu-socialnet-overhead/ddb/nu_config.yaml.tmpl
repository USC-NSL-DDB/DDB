---
# Rendered by start_ddb.sh -- edit this template, not the generated copy.
#
# Two things here are easy to get wrong and fail silently:
#   * `Framework` deserializes with serde(rename_all = "lowercase") and has a
#     #[serde(other)] catch-all, so `Nu` (capitalised) is accepted and quietly
#     becomes `Unspecified` -> "Unsupported framework adapter". It must be `nu`.
#   * Do NOT add PostrunGdbCommands: [-exec-continue]. After attaching, DDB
#     sends `signal SIG40`, which releases the connector's wait_for_debugger()
#     and re-traps via SIGTRAP. An auto-continue races that handshake and leaves
#     the process parked in sigwait forever. run_benchmark.sh resumes explicitly
#     once every server has attached.
Framework: nu
SSH:
  user: "@SSH_USER@"
  port: 22
PrerunGdbCommands:
  # Caladan preempts kthreads with SIGUSR1/SIGUSR2; gdb stops on both by default.
  - name: "disable CALADAN's custom signal handling"
    command: "handle SIGUSR1 SIGUSR2 nostop noprint"
ServiceDiscovery:
  Broker:
    # Must be an address the Nu servers on other nodes can reach: DDB writes
    # `tcp://<hostname>:<port>` into the service-discovery config they read.
    hostname: "@BROKER_IP@"
    managed:
      type: emqx
Conf:
  sudo: true
  on_exit: "kill"
  support_migration: false
  log_dir: "@LOG_DIR@"
  base_dir: "@BASE_DIR@"
  api_server_port: 5000
