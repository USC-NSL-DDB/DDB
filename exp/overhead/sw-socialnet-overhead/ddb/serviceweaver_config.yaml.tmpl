---
# Rendered by setup_ddb.sh -- do not edit the generated copy, edit this template.
#
# Shape must match ddb/core/src/common/config.rs:
#   - ServiceWeaverConf nests under ServiceDiscovery. At the top level it is
#     silently ignored, service_discovery stays None, and ddb logs
#     "[Service Discovery]: DISABLED" and attaches to nothing.
#   - the field is `jump_client_host`. The templates shipped in /local/tmp and
#     apps/.ddb spell it `jump_clinet_host`, which serde drops on the floor.
Framework: "serviceweaverkube"
SSH:
  user: root
  port: 22
ServiceDiscovery:
  ServiceWeaverConf:
    service_name: "@SERVICE_NAME@"
    kubectl_config_path: "@KUBECONFIG_PATH@"
    jump_client_host: "@GATEWAY_IP@"
    jump_client_port: 2222
    jump_client_user: "root"
    jump_client_password: "password123"
    jump_client_key_path: ""
PrerunGdbCommands:
  - name: "load extension"
    command: "source /workspace/extension.py"
Conf:
  log_dir: "@LOG_DIR@"
  base_dir: "@BASE_DIR@"
  api_server_port: 5000
