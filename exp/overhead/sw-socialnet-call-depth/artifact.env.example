# Copy this file to artifact.env only when auto-detection is insufficient.

# Set these only when reusing a nonstandard existing native-k3s installation.
# TARGET_NODE=existing-kubernetes-node-name
# KUBECONFIG=/path/to/existing-k3s.yaml
# K3S_SERVICE=existing-k3s.service
# NAMESPACE=default

# The two accepted external source trees. All experiment configs remain local.
# DDB_REPO_ROOT=/absolute/path/to/DDB
# DDB_SOURCE_DIR=/absolute/path/to/DDB/ddb
# SOCIALNET_DIR=/absolute/path/to/DDB/fwks/socialnetwork
# DDB_BIN=/absolute/path/to/DDB/ddb/target/release/ddb
# Fixed breakpoint revision; change only after porting all three breakpoints.
# EXPECTED_SOCIALNET_COMMIT=2a0fcf2a9a1de3ed8b2e4352b790dfa20ca5794a

# SocialNet is built only when it is not already deployed.
# SOCIALNET_BUILD_MODE=docker
# SOCIALNET_GO_IMAGE=golang:1.21.1
# SOCIALNET_IMAGE=h21565897/socialnet-serviceweaver:12345
# RESULTS_ROOT=/path/to/sw-socialnet-call-depth/results
# DDB_LOG_DIR=/path/to/runtime/logs
# DDB_BASE_DIR=/path/to/runtime

# Full-run measurement controls (validated defaults shown).
# DEPTH_WARMUP=3
# DEPTH_REPETITIONS=10
