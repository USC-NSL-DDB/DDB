---
# Generated by this recipe's setup_ddb.sh.
Framework: "serviceweaverkube"
SSH:
  user: root
  port: 22
ServiceDiscovery:
  ServiceWeaverConf:
    service_name: "@SERVICE_NAME@"
    kubectl_config_path: "@KUBECONFIG_PATH@"
    jump_client_host: "@GATEWAY_IP@"
    jump_client_port: 2222
    jump_client_user: "root"
    jump_client_password: "password123"
    jump_client_key_path: ""
PrerunGdbCommands:
  - name: "load base GDB extension"
    command: "source /workspace/extension.py"
  - name: "load ServiceWeaver runtime extension"
    command: "source /workspace/runtime-serviceweaver.py"
Conf:
  log_dir: "@LOG_DIR@"
  base_dir: "@BASE_DIR@"
  api_server_port: 5000
