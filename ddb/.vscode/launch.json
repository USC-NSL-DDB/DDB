{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug DDB with default config",
            "cargo": {
                "args": [
                    "build",
                    "--bin=ddb",
                    "--package=ddb"
                ],
                "filter": {
                    "name": "ddb",
                    "kind": "bin"
                }
            },
            "args": [
                "${workspaceFolder}/core/configs/dbg_auto_discovery.yaml",
                "--console-log",
                "--console-level",
                "debug",
                "--file-level",
                "trace"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug DDB with Config",
            "cargo": {
                "args": [
                    "build",
                    "--bin=ddb",
                    "--package=ddb"
                ],
                "filter": {
                    "name": "ddb",
                    "kind": "bin"
                }
            },
            "args": [
                "${input:configPath}",
                "--console-log",
                "--console-level",
                "debug"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "[QUICKSAND] Debug DDB",
            "cargo": {
                "args": [
                    "build",
                    "--bin=ddb",
                    "--package=ddb"
                ],
                "filter": {
                    "name": "ddb",
                    "kind": "bin"
                }
            },
            "args": [
                "${workspaceFolder}/core/configs/dbg_quicksand.yaml",
                "--console-log",
                "--console-level",
                "debug"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "[SW] Debug DDB",
            "cargo": {
                "args": [
                    "build",
                    "--bin=ddb",
                    "--package=ddb"
                ],
                "filter": {
                    "name": "ddb",
                    "kind": "bin"
                }
            },
            "args": [
                "/home/junzhouh/distributed_debugger/distributed-debugger/apps/.ddb/serviceweaver_dis.yml",
                "--console-log",
                "--console-level",
                "debug"
            ],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in DDB",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=ddb",
                    "--package=ddb"
                ],
                "filter": {
                    "name": "ddb",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": ["rust"]
        },
        {
            "name": "Python: Attach to GDB Extentsion Script",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5800
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/core/assets/gdb_ext",
                    "remoteRoot": "${workspaceFolder}/core/assets/gdb_ext"
                }
            ],
            "justMyCode": true,
            "presentation": {
                "hidden": false,
                "group": "Python",
                "order": 1
            }
        }
    ],
    "inputs": [
        {
            "id": "configPath",
            "type": "promptString",
            "description": "Path to config file",
            "default": "${workspaceFolder}/core/configs/dbg_auto_discovery.yaml"
        }
    ]
}