{
  "name": "@ddb/api-docs-site",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic DDB API reference portal and generated contracts",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "check": "node scripts/check-contracts.mjs",
    "build": "node scripts/build.mjs",
    "generate:site": "node scripts/build.mjs --prepare-only",
    "start": "npm run generate:site && docusaurus start",
    "serve": "docusaurus serve dist",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.1"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "protobufjs": "8.7.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
